  "fixed_sql": [
    {
      "name": "schools",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schools\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"cct\" TEXT NULL UNIQUE, \"organization\" TEXT NOT NULL, \"state\" TEXT NULL, \"municipality\" TEXT NULL, \"locality\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "school_years",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"school_years\" (\"id\" TEXT NOT NULL, \"label\" TEXT NOT NULL, \"starts_on\" INTEGER NOT NULL, \"ends_on\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (ends_on >= starts_on));"
        }
      ]
    },
    {
      "name": "teaching_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"teaching_groups\" (\"id\" TEXT NOT NULL, \"school_id\" TEXT NOT NULL REFERENCES schools (id) ON DELETE RESTRICT, \"school_year_id\" TEXT NOT NULL REFERENCES school_years (id) ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"shift\" TEXT NULL, \"schedule_start_minutes\" INTEGER NULL, \"schedule_end_minutes\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK ((schedule_start_minutes IS NULL AND schedule_end_minutes IS NULL) OR (schedule_start_minutes IS NOT NULL AND schedule_end_minutes IS NOT NULL AND schedule_start_minutes >= 0 AND schedule_start_minutes < 1440 AND schedule_end_minutes > schedule_start_minutes AND schedule_end_minutes < 1440)));"
        }
      ]
    },
    {
      "name": "group_grades",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"group_grades\" (\"group_id\" TEXT NOT NULL REFERENCES teaching_groups (id) ON DELETE CASCADE, \"grade\" TEXT NOT NULL, PRIMARY KEY (\"group_id\", \"grade\"));"
        }
      ]
    },
    {
      "name": "students",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"students\" (\"id\" TEXT NOT NULL, \"given_names\" TEXT NOT NULL, \"first_surname\" TEXT NOT NULL, \"second_surname\" TEXT NULL, \"birth_date\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "enrollments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"enrollments\" (\"id\" TEXT NOT NULL, \"student_id\" TEXT NOT NULL REFERENCES students (id) ON DELETE RESTRICT, \"group_id\" TEXT NOT NULL REFERENCES teaching_groups (id) ON DELETE RESTRICT, \"grade\" TEXT NOT NULL, \"list_number\" INTEGER NOT NULL, \"starts_on\" INTEGER NOT NULL, \"ends_on\" INTEGER NULL, PRIMARY KEY (\"id\"), FOREIGN KEY (group_id, grade) REFERENCES group_grades (group_id, grade), CHECK (list_number > 0), CHECK (ends_on IS NULL OR ends_on >= starts_on));"
        }
      ]
    },
    {
      "name": "attendance_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attendance_days\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES teaching_groups (id) ON DELETE RESTRICT, \"date\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"group_id\", \"date\"));"
        }
      ]
    },
    {
      "name": "attendance_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attendance_entries\" (\"attendance_day_id\" TEXT NOT NULL REFERENCES attendance_days (id) ON DELETE CASCADE, \"student_id\" TEXT NOT NULL REFERENCES students (id) ON DELETE RESTRICT, \"status\" TEXT NOT NULL, PRIMARY KEY (\"attendance_day_id\", \"student_id\"));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES teaching_groups (id) ON DELETE RESTRICT, \"title\" TEXT NOT NULL, \"lifecycle\" TEXT NOT NULL, \"methodology\" TEXT NOT NULL, \"formative_field\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "project_grades",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"project_grades\" (\"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"grade\" TEXT NOT NULL, PRIMARY KEY (\"project_id\", \"grade\"));"
        }
      ]
    },
    {
      "name": "activities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activities\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE RESTRICT, \"title\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "activity_grades",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_grades\" (\"activity_id\" TEXT NOT NULL REFERENCES activities (id) ON DELETE CASCADE, \"grade\" TEXT NOT NULL, PRIMARY KEY (\"activity_id\", \"grade\"));"
        }
      ]
    },
    {
      "name": "activity_roster",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_roster\" (\"activity_id\" TEXT NOT NULL REFERENCES activities (id) ON DELETE RESTRICT, \"student_id\" TEXT NOT NULL REFERENCES students (id) ON DELETE RESTRICT, \"grade\" TEXT NOT NULL, PRIMARY KEY (\"activity_id\", \"student_id\"), FOREIGN KEY (activity_id, grade) REFERENCES activity_grades (activity_id, grade));"
        }
      ]
    },
    {
      "name": "activity_evaluations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_evaluations\" (\"activity_id\" TEXT NOT NULL REFERENCES activities (id) ON DELETE RESTRICT, \"student_id\" TEXT NOT NULL REFERENCES students (id) ON DELETE RESTRICT, \"delivery_status\" TEXT NOT NULL, \"achievement\" TEXT NULL, \"observation\" TEXT NULL, PRIMARY KEY (\"activity_id\", \"student_id\"), FOREIGN KEY (activity_id, student_id) REFERENCES activity_roster (activity_id, student_id), CHECK (delivery_status = 'delivered' OR achievement IS NULL));"
        }
      ]
    },
    {
      "name": "student_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"student_records\" (\"student_id\" TEXT NOT NULL REFERENCES students (id) ON DELETE RESTRICT, \"strengths\" TEXT NULL, \"difficulties\" TEXT NULL, \"supports\" TEXT NULL, PRIMARY KEY (\"student_id\"));"
        }
      ]
    },
    {
      "name": "student_record_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"student_record_entries\" (\"id\" TEXT NOT NULL, \"student_id\" TEXT NOT NULL REFERENCES students (id) ON DELETE RESTRICT, \"kind\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"text\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
